# Cloud sync (GitHub sign-in). Fill in and restart the dev server to enable;
# without these the app runs fully local with no sync UI — identical to before.
# Both values are public identifiers, safe to commit in a bundle: privacy is
# enforced server-side by RLS policies (see supabase/schema.sql).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Supabase → Auth → URL Configuration → Redirect URLs must allowlist every
# origin that starts sign-in, otherwise Supabase falls back to the Site URL
# and the browser lands on a dead `?code=` page (ERR_CONNECTION_REFUSED).
# Allowlist at minimum:
#   http://localhost:8000
#   http://localhost:5173
#   https://hazem-alabiad.github.io/life-app/
